<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  --green:#6BAE2E; --green-deep:#2F6B1A; --green-ink:#1E4227; --dark:#12200F;
  --ice:#BFE3EA; --ice-deep:#3A8FA3; --sand:#E7E4D8; --hot:#E2542C;
  --serif:'Fraunces',Georgia,serif; --sans:'Instrument Sans',system-ui,sans-serif;
}
html,body{width:100%;height:100%;overflow:hidden;background:#000;font-family:var(--sans)}
#show{position:fixed;inset:0}
.slide{position:absolute;inset:0;display:flex;flex-direction:column;opacity:0;transition:opacity .45s ease;pointer-events:none;overflow:hidden}
.slide.active{opacity:1;pointer-events:auto}
.bg{position:absolute;inset:0;background-size:cover;background-position:center;transform:scale(1.03)}
.ov{position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,24,12,.86) 0%,rgba(12,24,12,.52) 42%,rgba(12,24,12,.88) 100%)}
.sc{position:relative;z-index:3;flex:1;display:flex;flex-direction:column;align-items:center;justify-content:center;
    padding:6vh 7vw;text-align:center;gap:clamp(14px,2.4vh,30px);color:#fff}

.kick{font-size:clamp(14px,1.5vw,22px);letter-spacing:.22em;text-transform:uppercase;font-weight:700;color:#9BE06A;
      text-shadow:0 2px 10px rgba(0,0,0,.6)}
.t-super{font-family:var(--serif);font-weight:600;font-size:clamp(52px,8.4vw,124px);line-height:1;letter-spacing:-.02em;
      text-shadow:0 4px 20px rgba(0,0,0,.6)}
.t-big{font-family:var(--serif);font-weight:600;font-size:clamp(40px,5.6vw,84px);line-height:1.06;letter-spacing:-.02em;
      text-shadow:0 3px 16px rgba(0,0,0,.6)}
.t-med{font-size:clamp(24px,2.9vw,44px);line-height:1.35;font-weight:600;text-shadow:0 2px 12px rgba(0,0,0,.6)}
.c-sand{color:var(--sand)}
em{font-style:normal;color:#9BE06A;font-weight:700}

.blist{list-style:none;text-align:left;max-width:1100px}
.blist li{display:flex;gap:16px;align-items:flex-start;font-size:clamp(24px,2.9vw,44px);line-height:1.35;font-weight:600;
      margin-bottom:clamp(10px,1.8vh,22px);text-shadow:0 2px 12px rgba(0,0,0,.6)}
.blist li::before{content:'';width:.42em;height:.42em;background:var(--green);border-radius:50%;margin-top:.52em;flex-shrink:0}
.blist.clue li::before{background:var(--hot)}

.chips{display:flex;flex-wrap:wrap;gap:clamp(8px,1vw,16px);justify-content:center;max-width:1200px}
.chip{border:2px solid rgba(255,255,255,.5);border-radius:999px;padding:.32em .95em;font-size:clamp(22px,2.5vw,38px);
      font-weight:600;background:rgba(0,0,0,.24);text-shadow:0 2px 10px rgba(0,0,0,.5)}

.gcard{background:rgba(255,253,248,.97);border-left:9px solid var(--green);border-radius:10px;
      padding:clamp(20px,3vw,44px) clamp(24px,4vw,56px);max-width:1100px;width:100%;text-align:left;color:#12200F;
      box-shadow:0 22px 60px rgba(0,0,0,.35)}
.ruleline{font-family:var(--serif);font-size:clamp(28px,3.4vw,52px);line-height:1.45;color:#12200F}
.ruleline em{color:var(--green-deep)}
.note{margin-top:.7em;padding-top:.6em;border-top:2px dashed var(--green);font-size:clamp(18px,1.9vw,28px);color:#4E5A4A;font-weight:600}
.note b{color:var(--green-deep)}

.lyrbox{background:rgba(18,32,15,.72);border-radius:22px;padding:clamp(24px,4vw,54px);max-width:1100px}
.lyr{font-family:var(--serif);font-size:clamp(30px,3.8vw,58px);line-height:1.5;font-weight:500}

.rev{margin-top:1vh}
.revbtn{font-family:var(--sans);font-size:clamp(18px,1.9vw,28px);font-weight:700;letter-spacing:.05em;
      background:var(--green);color:#fff;border:0;border-radius:999px;padding:.55em 1.6em;cursor:pointer}
.revbtn.sm{padding:.28em .9em;font-size:clamp(16px,1.6vw,24px)}
.rev.on .revbtn{display:none}
.revtxt{display:none;background:rgba(255,253,248,.96);color:#12200F;border-radius:16px;padding:.7em 1.1em;text-shadow:none;max-width:1000px}
.revtxt b{color:var(--green-deep)}
.rev.on .revtxt{display:block}

.steps{display:flex;flex-direction:column;gap:clamp(7px,1.1vh,14px);width:100%;max-width:1150px}
.step{display:flex;flex-direction:column;gap:6px;background:rgba(0,0,0,.40);
      border-radius:14px;padding:clamp(10px,1.2vw,18px) clamp(14px,1.8vw,24px)}
.step .row{display:flex;gap:14px;align-items:center;justify-content:space-between}
.step .q{text-align:left;font-size:clamp(20px,2.2vw,34px)}
.step .a{display:none;text-align:left;color:#9BE06A;font-weight:700;font-size:clamp(20px,2.2vw,34px)}
.step.on .a{display:block}
.step.on .revbtn{display:none}

.three{display:flex;gap:clamp(12px,2vw,32px);width:100%;max-width:1200px;justify-content:center}
.tcell{flex:1;max-width:340px}
.tim{height:clamp(150px,22vh,280px);border-radius:18px;background-size:cover;background-position:center;
     box-shadow:0 14px 40px rgba(0,0,0,.4)}
.tw{font-family:var(--serif);font-size:clamp(26px,2.8vw,44px);font-weight:600;margin-top:.35em}
.tn{font-size:clamp(16px,1.6vw,24px);color:var(--sand);font-weight:600}

.stamp{border:6px double var(--hot);color:var(--hot);font-family:var(--serif);font-weight:700;
      font-size:clamp(28px,3.6vw,56px);padding:.14em .7em;transform:rotate(-5deg);letter-spacing:.06em}

.chip-lesson{position:absolute;top:0;right:0;z-index:5;background:var(--green-ink);color:#fff;
      padding:.5em 1.1em .6em;border-bottom-left-radius:18px;font-size:clamp(13px,1.3vw,19px);
      font-weight:700;letter-spacing:.16em;text-transform:uppercase}
.tbtn{margin-top:1.5vh;font-family:var(--sans);font-size:clamp(17px,1.7vw,26px);font-weight:700;background:var(--hot);
      color:#fff;border:0;border-radius:999px;padding:.5em 1.5em;cursor:pointer}

#bar{position:fixed;left:0;right:0;bottom:0;height:8px;z-index:20;background:rgba(255,255,255,.16)}
#barfill{height:100%;width:0;background:var(--green);transition:width .35s}
#count{position:fixed;left:18px;bottom:20px;z-index:20;color:rgba(255,255,255,.75);font-size:15px;font-weight:700;letter-spacing:.1em}
#help{position:fixed;right:18px;bottom:20px;z-index:20;color:rgba(255,255,255,.55);font-size:13px;letter-spacing:.06em}
#timer{position:fixed;inset:0;z-index:40;display:none;align-items:center;justify-content:center;background:rgba(8,16,8,.93)}
#timer.on{display:flex}
#tnum{font-family:var(--serif);font-size:clamp(120px,26vw,420px);color:#9BE06A;font-weight:700;line-height:1}
#tnum.low{color:var(--hot)}

.ov-bright{position:absolute;inset:0;background:linear-gradient(180deg,rgba(12,24,12,.22) 0%,rgba(12,24,12,.04) 45%,rgba(12,24,12,.30) 100%)}
.k-face .sc{justify-content:flex-end;padding-bottom:9vh}
.rev.on .revtxt{cursor:pointer}
.step.on .a{cursor:pointer}
.steps.tight{gap:clamp(5px,.8vh,10px)}.steps.tight .step{padding:clamp(6px,.8vh,10px) clamp(14px,1.8vw,24px);gap:2px}.steps.tight .q,.steps.tight .a{font-size:clamp(18px,1.9vw,30px)}.steps.tight .revbtn.sm{padding:.18em .8em}

.tbtn.arc{display:inline-block;text-decoration:none;background:var(--green);font-size:clamp(20px,2.2vw,34px);padding:.55em 1.6em;box-shadow:0 8px 28px rgba(0,0,0,.4)}
.arcnote{margin-top:1vh;font-size:clamp(14px,1.4vw,20px);color:var(--sand);font-weight:600}
.chip-book{position:absolute;top:0;left:0;z-index:6;display:flex;gap:6px;background:var(--green-ink);color:#fff;text-decoration:none;
      padding:.5em 1.1em .6em;border-bottom-right-radius:18px;font-size:clamp(13px,1.3vw,19px);font-weight:700;letter-spacing:.12em;text-transform:uppercase}
.chip-book a{color:#fff;text-decoration:none;border-bottom:2px solid #9BE06A}
.chip-book a+a{margin-left:10px}

.aud{display:flex;align-items:center;gap:14px;background:rgba(0,0,0,.5);border:2px solid rgba(255,255,255,.35);border-radius:999px;padding:.35em 1em .35em 1.2em;color:#fff;font-weight:700;font-size:clamp(15px,1.5vw,22px)}
.aud audio{height:38px;width:min(380px,44vw)}
</style>
</head>
