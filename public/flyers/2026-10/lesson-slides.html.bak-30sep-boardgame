<script>
const S=[...document.querySelectorAll('.slide')];let i=0;
function show(n){document.querySelectorAll('audio').forEach(a=>a.pause());S[i].classList.remove('active');i=Math.max(0,Math.min(S.length-1,n));S[i].classList.add('active');
  document.getElementById('barfill').style.width=((i+1)/S.length*100)+'%';
  document.getElementById('count').textContent=(i+1)+' / '+S.length;}
function next(){show(i+1)}function prev(){show(i-1)}
document.addEventListener('keydown',e=>{
  if(e.target&&e.target.tagName==='AUDIO')return;
  if(e.key==='ArrowRight'||e.key===' '||e.key==='PageDown'){e.preventDefault();next()}
  else if(e.key==='ArrowLeft'||e.key==='PageUp'){e.preventDefault();prev()}
  else if(e.key==='r'||e.key==='R'){S[i].querySelectorAll('.rev,.step').forEach(el=>el.classList.add('on'))}
  else if(e.key==='f'||e.key==='F'){if(!document.fullscreenElement)document.documentElement.requestFullscreen();else document.exitFullscreen()}
  else if(e.key==='g'||e.key==='G'){const a=S[i].querySelector('a[data-arcade]');if(a)window.open(a.href,'_blank','noopener')}
  else if(e.key==='a'||e.key==='A'){const a=S[i].querySelector('audio');if(a){a.paused?a.play():a.pause()}}
  else if(e.key==='Escape'){stopTimer()}
  else if(e.key==='Home'){show(0)}else if(e.key==='End'){show(S.length-1)}
});
document.getElementById('show').addEventListener('click',e=>{
  if(e.target.closest('button,a,audio,.a,.revtxt'))return;
  (e.clientX>window.innerWidth*0.35)?next():prev();
});
document.addEventListener('play',e=>setTimeout(()=>e.target.blur&&e.target.blur(),0),true);document.addEventListener('pause',e=>setTimeout(()=>e.target.blur&&e.target.blur(),0),true);
let tI=null;
function startTimer(sec){const box=document.getElementById('timer'),num=document.getElementById('tnum');
  box.classList.add('on');let t=sec;
  const draw=()=>{num.textContent=Math.floor(t/60)+':'+String(t%60).padStart(2,'0');num.classList.toggle('low',t<=10)};
  draw();clearInterval(tI);tI=setInterval(()=>{t--;draw();if(t<=0){clearInterval(tI);num.textContent="TIME!"}},1000);}
function stopTimer(){clearInterval(tI);document.getElementById('timer').classList.remove('on')}
const BOOK=1;const BOOKURL='/flyers/2026-10/index.html';
S.forEach(sl=>{const d=sl.dataset.p;if(!d)return;const c=document.createElement('div');c.className='chip-book';c.appendChild(document.createTextNode('📖 Booklet '));d.split(',').forEach(n=>{const a=document.createElement('a');a.href=BOOKURL+'?p='+n;a.target='_blank';a.rel='noopener';a.textContent='p.'+n;c.appendChild(a)});sl.appendChild(c)});
function startSlide(){const m=(location.hash.match(/s=(\d+)/)||location.search.match(/[?&]s=(\d+)/)||[])[1];return m?+m-1:0}
const _show=show;show=function(n){_show(n);try{history.replaceState(null,'','#s='+(i+1))}catch(e){}};
window.addEventListener('hashchange',()=>{const n=startSlide();if(n!==i)_show(n)});
show(startSlide());
</script>
