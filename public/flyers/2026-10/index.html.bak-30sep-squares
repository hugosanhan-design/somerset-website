<script>
(function(){
  const pages=[...document.querySelectorAll('.pg')];
  const sel=document.getElementById('jump');
  pages.forEach((p,i)=>{p.id='page-'+(i+1);const o=document.createElement('option');o.value=i+1;o.textContent=i+1;sel.appendChild(o);});
  sel.addEventListener('change',()=>document.getElementById('page-'+sel.value).scrollIntoView({behavior:'smooth'}));
  // Deep link: ?p=N opens straight to page N (used by the teacher's portal)
  const qp=new URLSearchParams(location.search);
  const pTarget=parseInt(qp.get('p'),10);
  if(pTarget && document.getElementById('page-'+pTarget)){
    sel.value=String(pTarget);
    requestAnimationFrame(()=>document.getElementById('page-'+pTarget).scrollIntoView({block:'start'}));
  }
  let cur=null;
  const btns=t=>document.querySelectorAll('[data-track="'+t+'"]');
  function paint(t){const a=document.getElementById('a-'+t);
    btns(t).forEach(b=>{const on=!a.paused;b.classList.toggle('on',on);b.classList.toggle('paused',a.paused&&a.currentTime>0&&!a.ended);
      const ic=b.querySelector('.ic'),tx=b.querySelector('.tx');if(ic)ic.textContent=on?'❚❚':'▶';if(tx)tx.textContent=on?'Pause':(a.currentTime>0&&!a.ended?'Resume':'Listen');});}
  document.querySelectorAll('audio').forEach(a=>{const t=a.id.slice(2);
    ['play','pause','ended'].forEach(e=>a.addEventListener(e,()=>{if(e==='ended')a.currentTime=0;paint(t);}));
    a.addEventListener('timeupdate',()=>btns(t).forEach(b=>{const i=b.querySelector('.bar i');if(i)i.style.width=(100*a.currentTime/(a.duration||1))+'%';}));});
  document.addEventListener('click',e=>{const b=e.target.closest('[data-track]');if(!b)return;
    const t=b.dataset.track,a=document.getElementById('a-'+t);
    if(cur&&cur!==a){cur.pause();cur.currentTime=0;paint(cur.id.slice(2));}
    cur=a; if(a.paused)a.play();else a.pause();
    if(b.closest('.dbar')){const pb=document.querySelector('.play[data-track="'+t+'"]');pb&&pb.scrollIntoView({behavior:'smooth',block:'center'});}});
  document.addEventListener('keydown',e=>{if(e.code==='Space'&&cur&&e.target===document.body){e.preventDefault();cur.paused?cur.play():cur.pause();}});
})();
</script>
