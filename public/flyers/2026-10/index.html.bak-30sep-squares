  const pages=[...document.querySelectorAll('.pg')];
  const back=document.getElementById('lpBack'), box=document.getElementById('lp');
  const norm=t=>(t||'').replace(/\s+/g,' ').trim().toLowerCase();

  function reveal(row, ans, ex, i){
    if(row.classList.contains('done')) return;
    row.classList.add('done');
    const mode=ex.mode, hit=ex.hit ? ex.hit[i] : null;
    const pill=t=>{const s=document.createElement('span'); s.className='ans-pill'; s.textContent=t; return s;};
    if(mode==='gap'){
      const g=row.querySelector('.gap');
      if(g){ const s=document.createElement('span'); s.className='ans-fill'; s.textContent=ans; g.replaceWith(s); return; }
    }
    if(mode==='box'){
      const b=row.querySelector('.box');
      if(b){ b.classList.add('ans-box'); b.textContent=ans; return; }
    }
    if(mode==='mc'){
      const letter=(ans.trim()[0]||'').toLowerCase();
      const opts=[...row.querySelectorAll('.opt')];
      if(opts.length){ opts.forEach(o=>{ const l=norm((o.querySelector('i')||{}).textContent).replace(/[^a-z]/g,'');
        o.classList.add(l===letter?'hit':'dim'); }); return; }
    }
    if(mode==='pick'){
      const picks=[...row.querySelectorAll('.pick')];
      if(picks.length){ picks.forEach(p=>p.classList.add(norm(p.textContent)===norm(hit)?'hit':'dim')); return; }
    }
    if(mode==='tag'){
      const tags=[...row.querySelectorAll('.tag')];
      if(tags.length){ tags.forEach(t=>t.classList.add(norm(t.textContent)===norm(hit)?'hit':'dim'));
        row.appendChild(pill(ans.split('—').slice(1).join('—').trim()||ans)); return; }
    }
    row.appendChild(pill(ans));
  }

  function openEx(ex, card){
