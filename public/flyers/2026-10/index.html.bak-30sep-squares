    if(!card){ console.warn('no card', ex.page, ex.lab); return; }
    const n=(ex.mode==='sort' ? card.querySelectorAll('.sortbox') : card.querySelectorAll(ex.sel||'.q')).length;
    if(n < ex.ans.length) console.warn('row mismatch', ex.page, ex.lab, n, ex.ans.length);
    card.classList.add('ex-hot');
    const chip=document.createElement('span'); chip.className='ex-chip'; chip.textContent='✓ Correct in class'; card.appendChild(chip);
