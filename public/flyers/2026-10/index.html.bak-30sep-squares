<style>
@page{size:A4;margin:0}
:root{
  --green:#6BAE2E; --green-deep:#2F6B1A; --green-ink:#1E4227;
  --ice:#BFE3EA; --ice-deep:#3A8FA3; --ice-pale:#EAF6F8;
  --paper:#F7F3EA; --paper-2:#FFFDF8; --ink:#1B2419; --ink-soft:#4E5A4A; --rule:#DED8C8;
  --amber:#B45309; --hot:#E2542C;
  --serif:'Fraunces','Playfair Display',Georgia,serif;
  --sans:'Instrument Sans','Segoe UI',system-ui,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0}
svg{display:block;max-width:100%;height:auto}
body{font-family:var(--sans);font-size:11.5pt;line-height:1.55;color:var(--ink);background:#dcd9d0}

.pg{width:210mm;height:297mm;background:var(--paper);margin:0 auto 8px;position:relative;overflow:hidden;page-break-after:always;display:flex;flex-direction:column}
.pg:last-child{page-break-after:auto}
.in{padding:15mm 16mm 16mm;flex:1;display:flex;flex-direction:column}
@media print{body{background:#fff}.pg{margin:0}}

.ph{position:relative;overflow:hidden;background:linear-gradient(135deg,var(--ice) 0%,#dfeff2 60%,var(--ice-pale) 100%);display:block}
.ph::after{content:attr(data-label);position:absolute;inset:0;display:flex;align-items:center;justify-content:center;text-align:center;padding:12px;
  font-family:var(--sans);font-size:8pt;font-weight:700;letter-spacing:.08em;color:var(--ice-deep);line-height:1.5}
.ph img{position:relative;z-index:2;width:100%;height:100%;object-fit:cover;display:block}

.foot{position:absolute;left:16mm;right:16mm;bottom:8mm;display:flex;justify-content:space-between;align-items:baseline;
  font-size:8pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);border-top:1px solid var(--rule);padding-top:5px}
.foot .pn{font-family:var(--serif);font-size:13pt;font-weight:700;letter-spacing:0;color:var(--green-deep)}
.kick{font-size:8.5pt;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--ice-deep)}
.kick b{color:var(--green-deep)}
h1.hl{font-family:var(--serif);font-weight:600;font-size:40pt;line-height:.97;letter-spacing:-.025em;margin:7px 0 9px}
h1.hl.sm{font-size:32pt}
.deck{font-family:var(--serif);font-weight:400;font-size:14pt;line-height:1.32;color:var(--ink-soft);margin-bottom:11px}

/* ---------------- COVER ---------------- */
.cover{padding:0}
.cover-in{flex:1;display:flex;flex-direction:column;padding:13mm 15mm 12mm}
.cover-photo-frame{position:relative;height:112mm;border-radius:20px;overflow:hidden;margin:8mm 0 9mm;flex-shrink:0}
.cover-photo-frame .ph{width:100%;height:100%}
.masthead{font-family:var(--serif);font-weight:900;font-size:40pt;line-height:.86;letter-spacing:-.03em;color:var(--green-deep)}
.mast-row{display:flex;align-items:flex-end;justify-content:space-between;border-bottom:3px solid var(--green);padding-bottom:7px}
.mast-sub{text-align:right;font-size:8pt;font-weight:700;letter-spacing:.2em;text-transform:uppercase;line-height:1.8;color:var(--ink-soft)}
.coverlines{display:flex;flex-direction:column;gap:8px;max-width:135mm;margin-top:9px}
.cl{display:flex;align-items:baseline;gap:9px}
.cl .n{font-family:var(--serif);font-weight:700;font-size:14pt;color:var(--green-deep);line-height:1}
.cl .t{font-family:var(--serif);font-size:13pt;line-height:1.15;color:var(--ink)}
.cl .t em{font-style:normal;color:var(--ink-soft)}
.cover-title{font-family:var(--serif);font-weight:600;font-size:34pt;line-height:.98;letter-spacing:-.03em;color:var(--ink);margin-bottom:5px}
.cover-deck{font-family:var(--serif);font-size:13pt;line-height:1.28;color:var(--ink-soft);max-width:130mm;margin-bottom:2px}
.flash{position:absolute;right:7mm;top:7mm;z-index:4;background:#fff;border:2px solid var(--hot);border-radius:50%;width:28mm;height:28mm;
  display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;transform:rotate(-9deg);padding:6px}
.flash .b{font-family:var(--serif);font-weight:700;font-size:13pt;line-height:1;color:var(--hot)}
.flash .s{font-size:6.6pt;font-weight:700;letter-spacing:.1em;text-transform:uppercase;margin-top:3px;line-height:1.3;color:var(--hot)}
.cover-bottom{display:flex;justify-content:space-between;align-items:flex-end;border-top:1px solid var(--rule);padding-top:7px;
  font-size:8pt;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--ink-soft)}
.owner{margin-top:auto;background:#fff;border:1px solid var(--rule);border-radius:14px;padding:9px 14px;display:flex;gap:9mm;align-items:baseline}
.owner span{font-size:9pt;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);white-space:nowrap}
.owner .fld{flex:1;border-bottom:1.5px solid var(--ink-soft);height:16px}

/* ---------------- CONTENTS ---------------- */
.contents{width:100%;border-collapse:collapse;table-layout:fixed}
.contents td{border-top:1px solid var(--rule);padding:3.5px 0;vertical-align:middle}
.contents tr:last-child td{border-bottom:1px solid var(--rule)}
.c-pg{font-family:var(--serif);font-weight:700;font-size:16pt;color:var(--ice-deep);line-height:1;letter-spacing:-.03em}
.c-t{font-family:var(--serif);font-size:11.8pt;line-height:1.1}
.c-d{font-size:8.2pt;color:var(--ink-soft);margin-top:1px}
.c-tag{font-size:7.5pt;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--green-deep);text-align:right}

/* ---------------- panels ---------------- */
.claim{background:var(--green-ink);color:#F5F1E6;border-radius:20px;padding:20px 24px;position:relative;overflow:hidden;margin-bottom:11px}
.claim .lab{font-size:8.5pt;letter-spacing:.16em;text-transform:uppercase;color:#9BE06A;font-weight:700}
.claim p{font-family:var(--serif);font-size:15pt;line-height:1.3;margin-top:7px}
.crack{background:var(--paper-2);border:1.5px solid var(--ice-deep);border-radius:16px;padding:16px 20px;font-family:var(--serif);font-size:14pt;line-height:1.38;margin-bottom:11px}
.crack .lab{display:block;font-family:var(--sans);font-size:8.5pt;letter-spacing:.14em;text-transform:uppercase;color:var(--ice-deep);font-weight:700;margin-bottom:5px}
.pull{font-family:var(--serif);font-size:17pt;line-height:1.3;color:var(--green-ink);margin:11px 0;padding-left:14px;border-left:4px solid var(--green)}
.card{background:var(--paper-2);border:1px solid var(--rule);border-radius:18px;padding:13px 18px;margin-bottom:9px}
.card.green{border:2px solid var(--green)}
.card.ice{border:1.5px solid var(--ice-deep)}
.card h3{font-family:var(--serif);font-weight:600;font-size:17pt;line-height:1.1;margin-bottom:3px}
.card .lab{font-size:8.5pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ice-deep);margin-bottom:5px}
.card .sub{font-size:10pt;color:var(--ink-soft);margin-bottom:9px}

.body-txt{font-size:12.5pt;line-height:1.62}
.body-txt p{margin-bottom:9px}
.body-txt p:last-child{margin-bottom:0}
.body-txt strong{color:var(--green-deep)}
.dcap{font-family:var(--serif);font-weight:700;font-size:25pt;line-height:1;color:var(--green-ink)}

.tags{display:flex;flex-wrap:wrap;gap:6px}
.tag{background:#fff;border:1.5px solid var(--rule);border-radius:999px;padding:4px 13px;font-size:10.5pt;font-weight:600}
.tag.g{background:#EDF6E2;border-color:var(--green);color:var(--green-deep)}
.tag.i{background:var(--ice-pale);border-color:var(--ice);color:var(--ice-deep)}
.tag.h{background:#FCE9E3;border-color:#F0B9A8;color:var(--hot)}

.q{display:flex;gap:10px;align-items:flex-start;margin-bottom:9px;font-size:12pt;line-height:1.5}
.q:last-child{margin-bottom:0}
.qn{font-family:var(--serif);font-weight:700;font-size:13pt;color:var(--green-deep);min-width:16px;line-height:1.25}
.gap{display:inline-block;border-bottom:1.8px solid var(--ink-soft);min-width:78px;margin:0 4px}
.gap.lg{min-width:120px}
.wl{display:block;border-bottom:1px solid var(--rule);height:24px;margin:4px 0}
.tf{display:inline-flex;gap:5px;margin-left:auto}
.tf b{border:1.5px solid var(--rule);background:#fff;border-radius:999px;padding:3px 12px;font-size:9.5pt;font-weight:700;color:var(--ink-soft)}

.bub{background:#fff;border:1.5px solid var(--rule);border-radius:16px;border-bottom-left-radius:4px;padding:8px 14px;font-family:var(--serif);font-size:12.5pt;color:var(--green-ink)}
.bub.b{border-color:var(--ice-deep);border-bottom-left-radius:16px;border-bottom-right-radius:4px}
.bubs{display:flex;gap:9px;flex-wrap:wrap}

.stat{display:flex;gap:10px;margin:11px 0}
.stat div{flex:1;background:var(--paper-2);border:1px solid var(--rule);border-radius:14px;padding:13px 15px}
.stat b{display:block;font-family:var(--serif);font-size:27pt;font-weight:600;letter-spacing:-.03em;color:var(--green-deep);line-height:1}
.stat span{font-size:9.5pt;color:var(--ink-soft)}

.grid{display:flex;gap:10px}
.grid>*{flex:1}
.strip{display:flex;gap:8px;margin-bottom:11px}
.strip .cell{flex:1;border-radius:14px;overflow:hidden;background:var(--paper-2);border:1px solid var(--rule)}
.strip .cell .ph{height:36mm}
.strip .cell .cap{padding:6px 9px;font-size:10pt}
.strip .cell .lab{padding:6px;text-align:center;font-family:var(--serif);font-size:12pt;font-weight:600}

/* audio badge — for pages where a Somerset-recorded track belongs once produced */
.audio{display:inline-flex;align-items:center;gap:5px;background:var(--ice-pale);border:1px solid var(--ice-deep);border-radius:999px;padding:3px 12px;font-size:8.5pt;font-weight:700;color:var(--ice-deep);letter-spacing:.03em;margin-left:8px}

/* calendar */
.cal{width:100%;border-collapse:separate;border-spacing:3px;table-layout:fixed}
.cal th{font-size:8pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--ink-soft);padding-bottom:3px}
.cal td{height:7mm;border:1px solid var(--rule);border-radius:9px;vertical-align:top;padding:3px 5px;background:var(--paper-2)}
.cal td.x{border:none;background:transparent}
.cal .d{font-family:var(--serif);font-weight:700;font-size:11pt;line-height:1}
.cal .t{font-size:5.8pt;font-weight:700;letter-spacing:.06em;margin-top:3px;color:var(--green-deep)}
.cal td.cls{background:#EDF6E2;border-color:var(--green)}
.cal td.one{background:var(--green-ink);border-color:var(--green-ink)}
.cal td.one .d,.cal td.one .t{color:#fff}
.cal td.test{background:var(--hot);border-color:var(--hot)}
.cal td.test .d,.cal td.test .t{color:#fff}

/* survey */
.sv{width:100%;border-collapse:collapse;font-size:9.5pt}
.sv th{background:var(--green-ink);color:#fff;font-size:8.5pt;font-weight:700;padding:6px 4px;letter-spacing:.06em}
.sv td{border:1px solid var(--rule);height:7.6mm;background:#fff}

/* lesson route markers */
.lesson{position:absolute;top:0;right:0;background:var(--green-ink);color:#fff;
  padding:6px 14px 7px;border-bottom-left-radius:16px;font-size:8.5pt;font-weight:700;
  letter-spacing:.14em;text-transform:uppercase;z-index:6}
.lesson b{font-family:var(--serif);font-size:13pt;letter-spacing:0;margin-left:6px}
.warm{background:var(--hot);color:#fff;border-radius:16px;padding:12px 18px;margin-bottom:11px;display:flex;gap:14px;align-items:flex-start}
.warm .w-lab{font-size:8pt;font-weight:700;letter-spacing:.16em;text-transform:uppercase;opacity:.9;white-space:nowrap;padding-top:3px}
.warm .w-body{flex:1}
.warm h4{font-family:var(--serif);font-weight:600;font-size:16pt;line-height:1.1;margin-bottom:3px}
.warm p{font-size:12pt;line-height:1.4;opacity:.97}

/* route map */
.route{width:100%;border-collapse:separate;border-spacing:3px;table-layout:fixed}
.route td{background:var(--paper-2);border:1.5px solid var(--rule);border-radius:9px;padding:4px 2px;text-align:center;vertical-align:top}
.route .rd{font-family:var(--serif);font-weight:700;font-size:11.5pt;color:var(--green-deep);line-height:1}
.route .rl{font-size:6.8pt;font-weight:700;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);margin-top:3px;line-height:1.3}
.route .rbox{width:13px;height:13px;border:2px solid var(--green);border-radius:4px;margin:4px auto 0}

/* cut-out lab */
.cut{border:2.5px dashed var(--ink-soft);border-radius:14px;padding:13px 15px;background:#fff}
.cut .ct{font-family:var(--serif);font-weight:700;font-size:14pt;margin-bottom:6px}
.cut .cr{display:flex;justify-content:space-between;font-size:11pt;padding:3px 0;border-bottom:1px dotted var(--rule)}
.cut .cr:last-child{border-bottom:none}
.cut .ask{background:#fff;border:1px solid var(--ice-deep);border-radius:9px;padding:7px 10px;margin-top:8px;font-size:10pt;font-style:italic;color:var(--ink-soft)}
.scissors{text-align:center;font-size:9pt;color:var(--ink-soft);letter-spacing:.3em;margin:9px 0}

/* revision / test-prep */
.revq{background:var(--paper-2);border:1.5px solid var(--rule);border-radius:14px;padding:10px 14px;margin-bottom:7px}
.revq .rn{font-family:var(--serif);font-weight:700;color:var(--green-deep);margin-right:6px}

/* back */
.back{background:var(--green-ink);color:#F5F1E6}
.back .in{justify-content:space-between}
.next{font-family:var(--serif);font-weight:600;font-size:34pt;line-height:1;color:#fff;letter-spacing:-.02em}
.next em{font-style:normal;color:#9BE06A}

/* Unit 2 test pages (b/w friendly: white page, outlines only) */
.pg.test{background:#fff}
.pg.test .lesson{background:#fff;color:var(--ink);border:2px solid var(--ink);border-top:none;border-right:none}
.pg.test .opt{border-color:var(--ink-soft)}
.pg.test .opt i{background:#fff;border:1.5px solid var(--ink);color:var(--ink)}
.tname{display:flex;gap:8mm;margin:2mm 0 3mm;font-weight:700;font-size:12pt}
.tname .f{flex:1;border-bottom:1.5px solid var(--ink);height:18px}
.tname .s{flex:0 0 34mm}
.tnote{border:1.5px solid var(--ink-soft);border-radius:8px;padding:2.5mm 4mm;font-size:12pt;line-height:1.4;margin-bottom:2mm}
.tph{display:flex;align-items:baseline;gap:3mm;border-bottom:2px solid var(--green);margin:4mm 0 2mm;padding-bottom:1mm}
.tph .b{border:1.5px solid var(--ink);border-radius:999px;padding:0 10px;font-weight:700;font-size:12pt}
.tph .t{font-family:var(--serif);font-weight:700;font-size:14pt}
.tph .p{margin-left:auto;font-size:12pt;font-weight:700;color:var(--ink-soft)}
.tins{font-size:12pt;color:var(--ink-soft);margin-bottom:2mm}
.tq{margin-bottom:2.6mm;font-size:12pt;line-height:1.4;break-inside:avoid}
.tq .n{font-family:var(--serif);font-weight:800;margin-right:2mm}
.tq .opts{display:block;margin:1mm 0 0 7mm}
.tq .opt{display:inline-block;white-space:nowrap;border:none;background:none;padding:0;margin:0 7mm 0 0;font-size:12pt}
.tq .opt i{display:inline-block;width:6mm;height:6mm;line-height:5mm;text-align:center;margin-right:2mm;font-size:11pt}
.tq .opts.col .opt{display:block;margin:0 0 1mm 0}
.tq .wr{margin:1.5mm 0 0 7mm}
.tbox{border:1.5px solid var(--ink-soft);border-radius:10px;padding:2mm 4mm;margin-bottom:3mm;font-size:12pt;text-align:center}
.tline{display:block;border-bottom:1px solid var(--ink-soft);height:8.5mm;margin:0 0 0 7mm}

.pg.test .in{padding-top:12mm}
.pg.test h1.hl.sm{font-size:26pt;margin:1px 0 0}
.pg.test .tname{margin:1mm 0 2mm;line-height:1.2}
.tph{line-height:1.15;margin:3mm 0 1.5mm;padding-bottom:.5mm}
.tins{line-height:1.3;margin-bottom:1.5mm}
.tq{line-height:1.3;margin-bottom:1.8mm}
.tnote{line-height:1.3;padding:2mm 4mm;margin-bottom:1mm}
.tline{height:8mm}

.tbox.veg{display:flex;flex-wrap:wrap;justify-content:center;gap:1mm 2.6mm}</style>


<style>
/* ===== v2 additions (colour edition, 17 Sep 2026) ===== */
.lesson .ldate{display:block;font-size:7.5pt;letter-spacing:.1em;opacity:.85;margin-top:1px}
.warm.arcade{background:var(--green-ink)}
.warm.arcade .w-lab{color:#9BE06A}

/* v1 used these two classes without defining them */
.diary{background:var(--paper-2);border:1px solid var(--rule);border-left:4px solid var(--green);border-radius:14px;padding:12px 16px;font-size:12pt;line-height:1.5}
.diary .dt{font-family:var(--serif);font-weight:700;font-size:14pt;color:var(--green-ink);margin-bottom:6px}
.lines{height:30mm;background:repeating-linear-gradient(transparent 0 8.4mm,var(--rule) 8.4mm 8.8mm)}

/* multiple choice */
.mc{display:flex;gap:10px;align-items:flex-start;padding:5px 0;border-bottom:1px dotted var(--rule)}
.mc:last-child{border-bottom:none}
.mcb{flex:1}
.mcq{font-size:12.5pt;line-height:1.35;margin-bottom:4px}
.opts{display:flex;gap:8px;flex-wrap:wrap}
.opt{display:inline-flex;align-items:center;gap:6px;background:#fff;border:1.5px solid var(--rule);border-radius:999px;padding:2px 12px 2px 3px;font-size:12pt}
.opt i{font-style:normal;font-weight:700;width:20px;height:20px;border-radius:50%;background:var(--ice-pale);color:var(--ice-deep);display:inline-flex;align-items:center;justify-content:center;font-size:10.5pt}
.quizhead{display:flex;gap:12px;align-items:flex-end;margin-bottom:10px}
.quizhead>div:first-child{flex:1}
.scorebox,.grow{background:#fff;border:2.5px solid var(--hot);border-radius:16px;padding:8px 14px;text-align:center;min-width:40mm}
.scorebox span,.grow span{display:block;font-size:8.5pt;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--hot)}
.scorebox b,.grow b{display:block;font-family:var(--serif);font-size:24pt;line-height:1.1;border-bottom:1.5px solid var(--ink-soft);margin:2px 0 4px}
.scorebox em{font-size:9pt;color:var(--ink-soft)}
.grow{display:flex;align-items:center;gap:8px}
.grow b{border:none;border-bottom:1.5px solid var(--ink-soft);min-width:18mm;font-size:18pt;margin:0}
.grow i{font-style:normal;font-size:18pt;color:var(--hot)}
.steps{display:flex;gap:8px;margin-top:auto;margin-bottom:12mm}
.step{flex:1;background:var(--green-ink);color:#fff;border-radius:14px;padding:9px 12px;font-size:11pt;line-height:1.3}
.step b{display:block;font-family:var(--serif);font-size:18pt;color:#9BE06A;line-height:1}

/* matching + ordering */
.mrow{display:flex;align-items:center;gap:8px;min-height:9mm;border-bottom:1px dotted var(--rule);font-size:12pt}
.mrow:last-child{border-bottom:none}
.mw{flex:1;font-family:var(--serif);font-weight:600;font-size:13.5pt}
.box{display:inline-block;width:9mm;height:8mm;border:2px solid var(--green);border-radius:6px;background:#fff;flex-shrink:0}
.box.sm{width:5mm;height:5mm;border-width:1.5px;border-radius:3px}
.ordr{display:flex;align-items:center;gap:10px;font-size:12.5pt;margin:6px 0}
.pick{display:inline-block;border:1.5px solid var(--ice-deep);border-radius:999px;padding:0 9px;margin:0 2px;background:#fff}
.tiles{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:2px}
.tile{background:#FFF4DC;border:1.5px solid #E8A020;border-radius:7px;padding:1px 9px;font-size:12pt;font-weight:600}
.aans{display:flex;flex-wrap:wrap;gap:6px 16px;font-size:13pt}
.aan{white-space:nowrap}
.gap.sm{min-width:40px}
.sortbox{border:2px dashed var(--ice-deep);border-radius:12px;height:30mm;padding:6px 10px;font-size:11pt;color:var(--ice-deep);background:#fff}

/* plays */
.cast{display:flex;flex-wrap:wrap;gap:4px 14px;background:var(--ice-pale);border-radius:12px;padding:7px 12px;font-size:11.5pt;margin-bottom:9px}
