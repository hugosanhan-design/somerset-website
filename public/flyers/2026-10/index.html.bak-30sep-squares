    stage.classList.remove('ex-hot');
    stage.querySelectorAll('.ex-chip').forEach(c=>c.remove());
    const rows=[...(ex.mode==='sort' ? stage.querySelectorAll('.sortbox') : stage.querySelectorAll(ex.sel||'.q'))].slice(0, ex.ans.length);
    rows.forEach((r,i)=>{ r.classList.add('ex-line'); r.addEventListener('click',e=>{ e.stopPropagation(); reveal(r, ex.ans[i], ex, i); }); });
    box.innerHTML='';
    const top=document.createElement('div'); top.className='lp-top';
