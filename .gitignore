.vercel
node_modules
# Portal lives in the Somerset App repo — not part of the marketing website
/app/
_archive/

# Local dev SQLite database — never ship local test/dev data to production.
# This is also why past deployments carried stale test accounts: this wasn't excluded before.
/data/*
!/data/*.ts
!/data/*.json
!/data/cbt/
.env*

# Build artifacts / local-only files
.next/
tsconfig.tsbuildinfo
.DS_Store
somerset.db

# Local run-state cache for scripts/migrate-materials.mjs (skip-unchanged-files)
.migrate-blob-cache.json

# macOS duplicate files (created when copying a file that already exists)
* 2.txt
* 2.json
* 2.js
* 2.ts
* 2.tsx
* 2.md
* 2.sh
* 2.css
* 2.html
* 2.pdf
* 2.jpg
* 2.jpeg
* 2.png
* 2.gif
* 2.webp
