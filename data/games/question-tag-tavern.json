      { "id": "question-tag-tavern-b2-06", "q": "Everyone agrees, ___?", "options": ["don't they","doesn't he","aren't they"], "answer": 0, "why": "After everyone, the tag uses they, with do: don't they." },
      { "id": "question-tag-tavern-b2-07", "q": "Someone's coming, ___?", "options": ["aren't they","isn't he","is he"], "answer": 0, "why": "After someone, the tag uses they, so is becomes are: aren't they." },
