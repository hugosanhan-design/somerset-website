      { "id": "question-tag-tavern-c1-08", "q": "They'd never have guessed, ___?", "options": ["would they","wouldn't they","had they"], "answer": 0, "why": "“Never” is negative, and 'd have is would have: would they." },
      { "id": "question-tag-tavern-c1-09", "q": "It can't be true, ___?", "options": ["can it","can't it","could it"], "answer": 0, "why": "Negative modal, so the same modal in a positive tag: can it." },
